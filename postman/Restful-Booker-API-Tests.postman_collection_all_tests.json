    {
      "name": "Update Booking",

      "event": [
         {
           "listen": "test",
           "script": {
           "type": "text/javascript",
           "exec": [
             "console.log('Cookie variable:', pm.collectionVariables.get('Cookie'));",
             "console.log('Resolved Cookie:', pm.variables.replaceIn('{{Cookie}}'));",
             "",     
             "pm.test(\"Status code is 200\", function () {",
             "    pm.response.to.have.status(200);",
             "});",
               "",     
            "pm.test(\"firstname field has value of Jose\", function () {",
            "    pm.expect(pm.response.json()).to.have.property(\"firstname\",\"Jose\");", 
            "});",
            "",     
            "pm.test(\"lastname field has value of Brown\", function () {",
            "    pm.expect(pm.response.json()).to.have.property(\"lastname\",\"Brown\");", 
            "});",
            "",     
            "pm.test(\"Total price was updated to 111\", function () {",
            "    pm.expect(pm.response.json()).to.have.property(\"totalprice\", 111);", 
            "});"

            ]
           }
         }
