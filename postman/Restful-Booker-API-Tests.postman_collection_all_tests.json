    {
      "name": "GET Invalid Booking id",
            "event": [
        {
          "listen": "test",
          "script": {
          "type": "text/javascript",
          "exec": [
            "pm.test(\"Status code is 404\", function () {",
            "    pm.response.to.have.status(404);",
            "});",
            "",
            "pm.test(\"Response body does not include booking firstname\", function () {",
            "    pm.expect(pm.response.text()).to.not.include(\"firstname\");",
            "});",
            "",
            "pm.test(\"Response indicates booking was not found\", function () {",
            "    pm.expect(pm.response.text()).to.include(\"Not Found\");",
            "});"
          ]
        }
       }
     ],

